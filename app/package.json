{
  "name": "vibesim-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.playwright.json --noEmit",
    "lint": "eslint src e2e vite.config.ts vitest.config.ts playwright.config.ts --max-warnings 0",
    "lint:fix": "eslint src e2e vite.config.ts vitest.config.ts playwright.config.ts --fix",
    "format": "prettier --write src e2e vite.config.ts vitest.config.ts playwright.config.ts ../.github/workflows/*.yml",
    "format:check": "prettier --check src e2e vite.config.ts vitest.config.ts playwright.config.ts ../.github/workflows/*.yml",
    "fixture:check": "node ../scripts/extract-analyzer-fixture.mjs --check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "size": "npm run build && npm run size:check",
    "size:check": "size-limit",
    "preview": "vite preview"
  },
  "size-limit": [
    {
      "name": "initial JavaScript",
      "path": "dist/assets/index-*.js",
      "limit": "500 kB",
      "gzip": true,
      "message": "Inspect eager imports and full-library entry points; include any future static entry dependencies in this budget."
    },
    {
      "name": "all JavaScript chunks",
      "path": "dist/assets/*.js",
      "limit": "590 kB",
      "gzip": true,
      "message": "This budget includes the entry and every deferred application chunk."
    }
  ],
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.15.20",
    "@tanstack/react-query": "^5.101.2",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.5",
    "size-limit": "^12.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
